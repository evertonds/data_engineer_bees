# .env.example
# Copy this file to .env and fill in your actual values
# Command: cp .env.example .env

# ============================================
# API Configuration
# ============================================
BREWERY_API_URL=https://api.openbrewerydb.org/v1
BREWERY_API_RATE_LIMIT=50
BREWERY_API_TIMEOUT=30

# ============================================
# Database Configuration (Local Development)
# ============================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=breweries
POSTGRES_USER=airflow
POSTGRES_PASSWORD=PASSWORD  # IMPORTANT: Change this!

# ============================================
# Airflow Configuration
# ============================================
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:CHANGE_ME_STRONG_PASSWORD@postgres/breweries
AIRFLOW__CORE__FERNET_KEY=GENERATE # Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__SCHEDULER__DAG_DIR_LIST_INTERVAL=30
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=true
AIRFLOW__WEBSERVER__SECRET_KEY=SECRET_KEY  # Change this!

# ============================================
# AWS Configuration (Optional - for S3 storage)
# ============================================
# Uncomment and fill when using S3
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_DEFAULT_REGION=us-east-1
# AWS_SESSION_TOKEN=  # Optional for temporary credentials

# ============================================
# Storage Configuration
# ============================================
STORAGE_TYPE=local  # Options: local, s3
LOCAL_DATA_PATH=/opt/airflow/data

# S3 Bucket names (used when STORAGE_TYPE=s3)
S3_BUCKET_BRONZE=brewery-data-lake-bronze-dev
S3_BUCKET_SILVER=brewery-data-lake-silver-dev
S3_BUCKET_GOLD=brewery-data-lake-gold-dev

# ============================================
# Great Expectations Configuration
# ============================================
GE_CHECKPOINT_ENABLED=true
GE_DATA_DOCS_ENABLED=true

# ============================================
# Spark Configuration
# ============================================
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_APP_NAME=BreweryPipeline

# ============================================
# dbt Configuration
# ============================================
DBT_PROFILES_DIR=/opt/airflow/dbt_project
DBT_TARGET=dev

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# ============================================
# Pipeline Configuration
# ============================================
PIPELINE_SCHEDULE="0 2 * * *"  # Daily at 2 AM
PIPELINE_RETRIES=3
PIPELINE_RETRY_DELAY=300  # 5 minutes in seconds
